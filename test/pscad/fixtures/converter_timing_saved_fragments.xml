  <Definition classid="UserCmpDefn" name="zminusone" url="" view="false" instances="0" date="0" crc="117562198" id="670745022" group="Miscellaneous">
    <form name="Feedback Loop Selector" w="280" h="420" splitter="70" commentlines="4">
      <category name="Configuration" visible="true">
        <cond />
        <parameter type="Text" name="Name" desc="Feedback Signal Comment" group="" helpmode="Append" allowemptystr="false">
          <value>Loop</value>
          <cond />
          <help />
          <regex />
          <error_msg />
        </parameter>
        <parameter type="Choice" name="Type" desc="Data Type" group="" helpmode="Append">
          <value>2</value>
          <cond />
          <help />
          <choice>0 = Logical</choice>
          <choice>1 = Integer</choice>
          <choice>2 = Real</choice>
          <choice>3 = Complex</choice>
        </parameter>
        <parameter type="Integer" name="Dim" desc="Dimension" content_type="Literal" min="1" max="2147483647" unit="" group="" helpmode="Append" intent="Input" dim="1">
          <value>1</value>
          <cond />
          <help />
        </parameter>
      </category>
      <category name="Initial Values" visible="true">
        <cond />
        <parameter type="Choice" name="Init" desc="Specify Initial Values" group="" helpmode="Append">
          <value>0</value>
          <cond />
          <help />
          <choice>0 = No</choice>
          <choice>1 = Yes</choice>
        </parameter>
        <parameter type="Choice" name="InitL" desc="Initial Logical Value" group="" helpmode="Append">
          <value>0</value>
          <cond>(Init==1)&amp;&amp;(Type==0)</cond>
          <help />
          <choice>0 = False</choice>
          <choice>1 = True</choice>
        </parameter>
        <parameter type="Integer" name="InitI" desc="Initial Integer Value" content_type="Literal" min="-2147483648" max="2147483647" unit="" group="" helpmode="Append" intent="Input" dim="1">
          <value>0</value>
          <cond>(Init==1)&amp;&amp;(Type==1)</cond>
          <help />
        </parameter>
        <parameter type="Real" name="InitR" desc="Initial Real Value" content_type="Literal" min="-1E+308" max="1E+308" unit="" group="" helpmode="Append" intent="Input" dim="1">
          <value>0.0</value>
          <cond>(Init==1)&amp;&amp;(Type==2)</cond>
          <help />
        </parameter>
        <parameter name="InitC" desc="Initial Complex Value" type="Complex" group="" helpmode="Append" content_type="Literal" intent="Input" dim="1" unit="" min="-1E+308" max="1E+308">
          <value>(0.0, 0.0)</value>
          <cond>(Init==1)&amp;&amp;(Type==3)</cond>
          <help />
        </parameter>
      </category>
    </form>
    <svg viewBox="-200 -200 200 200">
      <port model="Transfer" name="INR:Dim" x="36" y="0" dim="0" mode="Output" type="Real">Type==2</port>
      <port model="Transfer" name="OUTR:Dim" x="-36" y="0" dim="0" mode="Input" type="Real">Type==2</port>
      <port model="Transfer" name="INL:Dim" x="36" y="0" dim="0" mode="Output" type="Logical">Type==0</port>
      <port model="Transfer" name="INI:Dim" x="36" y="0" dim="0" mode="Output" type="Integer">Type==1</port>
      <port model="Transfer" name="OUTI:Dim" x="-36" y="0" dim="0" mode="Input" type="Integer">Type==1</port>
      <port model="Transfer" name="OUTL:Dim" x="-36" y="0" dim="0" mode="Input" type="Logical">Type==0</port>
      <line x1="7" y1="0" x2="-7" y2="0" stroke="Black" stroke-dasharray="none" stroke-width="0.2" />
      <line x1="18" y1="-7" x2="25" y2="0" stroke="Blue" stroke-dasharray="none" stroke-width="0.2" />
      <line x1="-18" y1="-7" x2="-10" y2="0" stroke="Blue" stroke-dasharray="none" stroke-width="0.2" />
      <line x1="12" y1="0" x2="25" y2="0" stroke="Blue" stroke-dasharray="none" stroke-width="0.2" />
      <line x1="-25" y1="0" x2="-10" y2="0" stroke="Blue" stroke-dasharray="none" stroke-width="0.2" />
      <line x1="36" y1="0" x2="28" y2="0" stroke="Black" stroke-dasharray="none" stroke-width="0.2" />
