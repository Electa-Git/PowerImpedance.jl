    <script>
      <segment name="Fortran" id="597801431" classid="CoreSegment">! $Name
#IF  Type==0
 #IF Init==1
  #TOP ~
      IF (TIMEZERO) $INL = ~
  #CASE InitL {~.FALSE.}{~.TRUE.}
 #ENDIF
#ELSEIF  Type==1
 #IF Init==1
  #TOP ~
      IF (TIMEZERO) $INI = $InitI
 #ENDIF
#ELSEIF Type==2
 #IF Init==1
  #TOP ~ 
      IF (TIMEZERO) $INR = $InitR
 #ENDIF
#ELSEIF Type==3
 #IF Init==1
  #TOP ~ 
      IF (TIMEZERO) $INC = $InitC
 #ENDIF
#ENDIF
#IF  Type==0
      $INL = $OUTL
#ELSEIF  Type==1
      $INI = $OUTI
#ELSEIF Type==2
      $INR = $OUTR
#ELSEIF Type==3
      $INC = $OUTC
#ENDIF</segment>
      <segment name="FlyBy" id="666179770" classid="CoreSegment">When this component is used in a feedback loop,
PSCAD will break the loop (by adding a time step delay)
at the selected point.  Without this component, PSCAD
will insert a time step delay in an optimum spot.
If used where a feedback path does not exist, this component
does nothing.</segment>
    </script>
  </Definition>
