        <choice>14 = 14</choice>
        <choice>15 = 15</choice>
        <choice>16 = 16</choice>
        <choice>17 = 17</choice>
        <choice>18 = 18</choice>
        <choice>19 = 19</choice>
        <choice>20 = 20</choice>
        <choice>21 = 21</choice>
        <choice>22 = 22</choice>
        <choice>23 = 23</choice>
