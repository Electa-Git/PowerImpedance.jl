<Definition classid="UserCmpDefn" name="tline_interface" url="" view="false" instances="0" date="0" crc="6751493" id="1186657786" group="Transmission Line">
  <!--PSCAD 5.1.0 station master.pslx SHA256 0d181e2f1c3eb57ae8019ba6d6311aee458dda02d080a8c4a92c26e6fdad5aeb; fields and scalar ports used by NC=2, View=0.-->
  <form>
    <category name="Configuration">
      <parameter type="Text" name="Name" desc="Name (Same as Configuration)" group="_General" helpmode="Overwrite" allowemptystr="false" min="0" max="0">
        <value>TLine</value>
        <cond type="Enable" />
        <help>Enter a name, which matches the associated transmission line configuration component (wire).</help>
        <regex>(^((\w{1,31})(:)){0,1})\w{1,31}$</regex>
        <error_msg>Segment name must not exceed 31 characters, nor contain any spaces or characters from the set: /\\*?\"&lt;&gt;| .~+-(){}[]!@#$%^&amp;.</error_msg>
        <vis />
      </parameter>
      <parameter desc="Segment End Specification" name="send_recv" group="_General" type="Choice" helpmode="Overwrite" animate="false">
        <value>0</value>
        <cond type="Enable" />
        <help>Specify which end of the transmission segment this is: Sending or receiving. It is only necessary to specify if the associated segment is part of a mutually coupled group of segments. Otherwise, you can leave this option as automatic. Specifying endpoints is necessary in order to ensure proper node/subsystem mapping and accurate runtime results.</help>
        <vis />
        <choice>0 = automatic</choice>
        <choice>1 = sending</choice>
        <choice>2 = receiving</choice>
      </parameter>
      <parameter type="Choice" name="NC" desc="Number of Equivalent Conductors" group="_General" helpmode="Append" animate="false">
        <value>3</value>
        <cond type="Enable" />
        <help />
        <vis />
        <choice>1 = 1</choice>
        <choice>2 = 2</choice>
        <choice>3 = 3</choice>
        <choice>4 = 4</choice>
        <choice>5 = 5</choice>
        <choice>6 = 6</choice>
