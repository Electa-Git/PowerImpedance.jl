        <choice>30 = 30</choice>
      </parameter>
      <parameter type="Choice" name="View" desc="Graphics Display" group="_General" helpmode="Overwrite" animate="false">
        <value>1</value>
        <cond type="Enable">(true)</cond>
        <help>Choose from Single line or Individual phases</help>
        <vis />
        <choice>0 = Individual phases view</choice>
        <choice>1 = Single line view</choice>
      </parameter>
      <parameter desc="Sending Signal Dimension" name="dim_s" group="Control Signal Transfer" unit="" min="0" max="1024" content_type="Literal" type="Integer" helpmode="Append" intent="Input" dim="1" animate="false">
        <value>0</value>
        <cond type="Enable" />
        <help>Enter the dimension of optional non-electrical signal to be transferred to the other end of the line</help>
        <vis />
      </parameter>
      <parameter desc="Receiving Signal Dimension" name="dim_r" group="Control Signal Transfer" unit="" min="0" max="1024" content_type="Literal" type="Integer" helpmode="Append" intent="Input" dim="1" animate="false">
        <value>0</value>
        <cond type="Enable" />
        <help>Enter the dimension of optional non-electrical signal to be received from the other end of the line</help>
        <vis />
      </parameter>
